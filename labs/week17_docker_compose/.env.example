# Django launch-events — environment variables
# Copy this to .env and fill in values for docker compose

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me-to-a-real-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=0

# PostgreSQL
POSTGRES_DB=launchevents
POSTGRES_USER=launchevents
POSTGRES_PASSWORD=launchevents_secret
DATABASE_URL=postgres://launchevents:launchevents_secret@db:5432/launchevents

# Redis
REDIS_URL=redis://redis:6379/0

# Optional
COLLECT_STATIC=0
